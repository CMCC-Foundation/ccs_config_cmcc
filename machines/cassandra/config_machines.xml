
  <machine MACH="cassandra">
    <DESC>CMCC Lenovo SD650 v3, Intel Xeon Max 9480 (56 pes/node), mem 1 TB/node (HBM 64 GB), Infiniband NDR, GPFS, Linux Red Hat 9.4, LSF v10.2</DESC>
    <OS>LINUX</OS>
    <COMPILERS>intel</COMPILERS>
    <MPILIBS>impi</MPILIBS>
    <PROJECT>R000</PROJECT>
    <CIME_OUTPUT_ROOT>/work/cmcc/$ENV{USER}/CMCC-CM</CIME_OUTPUT_ROOT>
    <DIN_LOC_ROOT>$ENV{CESMDATAROOT}/inputdata</DIN_LOC_ROOT>
    <DIN_LOC_ROOT_CLMFORC>$DIN_LOC_ROOT/atm/datm7</DIN_LOC_ROOT_CLMFORC>
    <DOUT_S_ROOT>$CIME_OUTPUT_ROOT/archive/$CASE</DOUT_S_ROOT>
    <BASELINE_ROOT>$ENV{CESMDATAROOT}/ccsm_baselines</BASELINE_ROOT>
    <CCSM_CPRNC>$ENV{CESMDATAROOT}/cesm2_tools/cprnc/cprnc</CCSM_CPRNC>
    <PERL5LIB>/usr/lib64/perl5:/usr/share/perl5</PERL5LIB>
    <GMAKE_J>8</GMAKE_J>
    <BATCH_SYSTEM>lsf</BATCH_SYSTEM>
    <SUPPORTED_BY>cmcc</SUPPORTED_BY>
    <MAX_TASKS_PER_NODE>112</MAX_TASKS_PER_NODE>
    <MAX_MPITASKS_PER_NODE>112</MAX_MPITASKS_PER_NODE>
    <PROJECT_REQUIRED>TRUE</PROJECT_REQUIRED>
    <mpirun mpilib="default">
      <executable> mpiexec.hydra </executable> 
    </mpirun>
    <module_system type="module" allow_error="true">
      <init_path lang="perl">/cassandra/opt/module-environment/5.4.0/init/perl.pm</init_path>
      <init_path lang="python">/cassandra/opt/module-environment/5.4.0/init/python.py</init_path>
      <init_path lang="csh">/cassandra/opt/module-environment/5.4.0/init/csh</init_path>
      <init_path lang="sh">/cassandra/opt/module-environment/5.4.0/init/sh</init_path>
      <cmd_path lang="perl">/cassandra/opt/module-environment/5.4.0/bin/modulecmd perl</cmd_path>
      <cmd_path lang="python">/cassandra/opt/module-environment/5.4.0/bin/modulecmd python </cmd_path>
      <cmd_path lang="sh">module</cmd_path>
      <cmd_path lang="csh">module</cmd_path>
      <modules>
        <command name="purge"/>
      </modules>
      <modules compiler="intel">
          <command name="load">oneapi-2025.0.4/2025.0.4-bwtfc</command>
          <command name="load">oneapi-2025.0.4/impi-2021.14.2/2021.14.2-e7cvt</command>
          <command name="load">oneapi-2025.0.4/impi-2021.14.2/intel-oneapi-mkl/2024.2.2-frprs</command>
          <command name="load">oneapi-2025.0.4/impi-2021.14.2/hdf5/1.14.5-hiifk</command>
          <command name="load">oneapi-2025.0.4/impi-2021.14.2/netcdf-c/4.9.2-n5ufg</command>
          <command name="load">oneapi-2025.0.4/impi-2021.14.2/netcdf-fortran/4.6.1-vcy3j</command>
          <command name="load">oneapi-2025.0.4/impi-2021.14.2/parallel-netcdf/1.14.0-5pihb</command>
          <command name="load">oneapi-2025.0.4/impi-2021.14.2/xios/2.6-m6i2q</command>
          <command name="load">oneapi-2025.0.4/impi-2021.14.2/parmetis/4.0.3-m6qhh</command>
          <command name="load">oneapi-2025.0.4/perl-xml-libxml/2.0210-szkkj</command>
          <command name="load">oneapi-2025.0.4/perl-xml-sax-base/1.09-hzmjc</command>
          <command name="load">oneapi-2025.0.4/cmake/3.31.5-5aqrp</command>
          <command name="load">oneapi-2025.0.4/py-setuptools/69.2.0-cuj2e</command>
          <command name="load">oneapi-2025.0.4/blitz/1.0.2-43urb</command>
      </modules>
      <modules compiler="intel" DEBUG="TRUE"> 
        <command name="load">oneapi-2025.0.4/impi-2021.14.2/esmf-debug/8.8.0-64ynz</command>  
      </modules>
      <modules compiler="intel" DEBUG="FALSE"> 
        <command name="load">oneapi-2025.0.4/impi-2021.14.2/esmf/8.8.0-dtpde</command> 
      </modules> 
    </module_system>
    <environment_variables>
      <env name="XIOS_PATH">$ENV{XIOS_ROOT}</env>
    </environment_variables>
    <environment_variables comp_interface="nuopc">
      <env name="ESMF_RUNTIME_PROFILE">ON</env>
      <env name="ESMF_RUNTIME_PROFILE_OUTPUT">SUMMARY</env>
      <!-- <env name="PIO_INCDIR">$ENV{PARALLELIO_ROOT}/include</env> --> 
      <!-- <env name="PIO_LIBDIR">$ENV{PARALLELIO_ROOT}/lib</env> --> 
    </environment_variables>
    <environment_variables compiler="intel"> 
	<env name="I_MPI_HYDRA_BOOTSTRAP">lsf</env> 
	<env name="I_MPI_HYDRA_BRANCH_COUNT">{{ num_nodes }}</env> 
    </environment_variables>
  </machine>
