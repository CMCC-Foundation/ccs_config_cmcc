
  <machine MACH="leonardo">
    <DESC> CINECA Leonardo Intel Sapphire Rapids processors, os is Linux, 56 pes/node, batch system is SLURM 22.05</DESC>
    <OS>LINUX</OS>
    <COMPILERS>intel</COMPILERS>
    <MPILIBS>impi</MPILIBS>
    <CIME_OUTPUT_ROOT>/leonardo_work/$ENV{account_name}/CMCC-CM</CIME_OUTPUT_ROOT>
    <DIN_LOC_ROOT>$ENV{CESMDATAROOT}/inputdata</DIN_LOC_ROOT>
    <DIN_LOC_ROOT_CLMFORC>$DIN_LOC_ROOT/atm/datm7</DIN_LOC_ROOT_CLMFORC>
    <DOUT_S_ROOT>$CIME_OUTPUT_ROOT/archive/$CASE</DOUT_S_ROOT>
    <BASELINE_ROOT>$ENV{CESMDATAROOT}/ccsm_baselines</BASELINE_ROOT>
    <CCSM_CPRNC>$ENV{CESMDATAROOT}/cesm2_tools/cprnc/cprnc</CCSM_CPRNC>
    <PERL5LIB>/usr/lib64/perl5:/usr/share/perl5</PERL5LIB>
    <GMAKE_J>8</GMAKE_J>
    <BATCH_SYSTEM>slurm</BATCH_SYSTEM>
    <SUPPORTED_BY>cineca</SUPPORTED_BY>
    <MAX_TASKS_PER_NODE>112</MAX_TASKS_PER_NODE>
    <MAX_MPITASKS_PER_NODE>96</MAX_MPITASKS_PER_NODE>
    <mpirun mpilib="default">
     <!--  <executable> srun </executable> -->
       <executable> srun</executable>
      <arguments>
        <arg name="binding">--cpu-bind=cores</arg>
        <arg name="num_tasks">--ntasks={{ total_tasks }}</arg>
        <arg name="killonbadexit"> --kill-on-bad-exit</arg>
      </arguments>
      <!-- arguments>
       <arg name="thread_count"> -x OMP_NUM_THREADS=$ENV{OMP_NUM_THREADS}</arg>
      </arguments-->
    </mpirun>
    <module_system type="module">
      <init_path lang="perl">/leonardo/prod/opt/environment/module/current/init/perl.pm</init_path>
      <init_path lang="python">/leonardo/prod/opt/environment/module/current/init/python.py</init_path>
